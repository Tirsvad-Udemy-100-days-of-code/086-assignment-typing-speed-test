# Doxygen configuration for Watermark Image (Python sources in src/).
# Build: doxygen Doxyfile   (output: build/doxygen/index.html)
PROJECT_NAME           = "Typing Speed Test"
PROJECT_BRIEF          = "Desktop app that tests and trains typing speed"
OUTPUT_DIRECTORY       = build
INPUT                  = src
RECURSIVE              = YES
FILE_PATTERNS          = *.py
OPTIMIZE_OUTPUT_JAVA   = YES
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
JAVADOC_AUTOBRIEF      = YES
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
GENERATE_HTML          = YES
HTML_OUTPUT            = doxygen
GENERATE_LATEX         = NO
HAVE_DOT               = NO
